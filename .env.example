# Pass environment variables through your host or shell. Never commit credentials.
PUBLIC_ORIGIN=https://your-drop-host.example
# For split hosting, PUBLIC_ORIGIN above is the Vercel FRONTEND origin (Render setting).
# Public build-time URL, not a secret: set only in Vercel frontend settings.
# VITE_SIGNAL_ORIGIN=https://your-pairing-service.onrender.com
PORT=5173
# Optional: only actual hosting reverse-proxy IPs/CIDRs, after confirming its forwarding policy.
# Do not use 0.0.0.0/0, ::/0 or all private networks. Unset means forwarded IPs are ignored.
# TRUSTED_PROXY_CIDRS=
# Optional coturn REST-auth relay; these are SERVER-side variables.
# Choose coturn OR Cloudflare, never both.
# TURN_URLS=turn:relay.example:3478,turns:relay.example:5349
# TURN_SECRET=
# Cloudflare TURN: Render/server only, never Vercel VITE_ variables.
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=

# Public canonical frontend origin for build-time SEO generation (not a secret).
# SITE_ORIGIN=https://your-real-frontend-domain

